{
  "name": "slop-davos",
  "private": true,
  "type": "module",
  "description": "A Davos simulation built with three.js, WebGPURenderer and TSL, from swisstopo and OpenStreetMap data.",
  "license": "MIT",
  "scripts": {
    "data:osm": "bash tools/overpass.sh tools/data/cache/osm_davos.json tools/data/q_davos.overpassql",
    "data:areas": "bash tools/overpass.sh tools/data/cache/osm_davos_areas.json tools/data/q_davos_areas.overpassql",
    "data:terrain": "node tools/build-davos-terrain.mjs",
    "data:decks": "node tools/fetch-bridge-decks.mjs",
    "data:geo": "node tools/build-davos-geodata.mjs",
    "data:surroundings": "node tools/build-davos-surroundings.mjs",
    "data": "npm run data:osm && npm run data:areas && npm run data:terrain && npm run data:decks && npm run data:geo && npm run data:surroundings && npm run data:swissimage && npm run data:roofs && npm run data:bergbahnen",
    "update:buildings": "node tools/update-swissbuildings3d.mjs",
    "serve": "python3 tools/serve.py 8765",
    "test": "node --test tests/*.cjs tests/*.mjs",
    "data:swissimage": "node tools/fetch-swissimage.mjs",
    "data:roofs": "node tools/build-roof-atlases.mjs",
    "data:vbd": "node tools/fetch-vbd.mjs",
    "data:shops": "node tools/fetch-shops.mjs",
    "data:parking": "node tools/fetch-parking.mjs",
    "data:ski-pistes": "node tools/fetch-ski-pistes.mjs",
    "data:streams": "node tools/fetch-streams.mjs",
    "data:hires": "node tools/fetch-swissimage.mjs --hires && node tools/build-roof-atlases.mjs --hires",
    "data:bergbahnen": "node tools/fetch-bergbahnen.mjs",
    "data:facades": "node tools/fetch-mapillary.mjs",
    "data:gwr": "node tools/build-gwr.mjs",
    "data:tlm-trees": "node tools/fetch-tlm-trees.mjs",
    "data:parking-bays": "node tools/detect-parking-bays.mjs",
    "data:ground": "node tools/trace-ground.mjs --layer sports",
    "bake:trees": "node tools/bake-ez-trees.mjs"
  },
  "devDependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "geotiff": "^2.1.3",
    "sharp": "^0.35.5"
  }
}
